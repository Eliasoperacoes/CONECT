# ============================================================
# CONECTA — Malachias Autopeças
# ============================================================
#
# SEM estas variáveis o sistema funciona normalmente, guardando tudo no
# navegador (modo local, bom para testar). COM elas, os dados passam a
# viver no banco e todas as lojas enxergam a mesma informação.
#
# Onde encontrar: supabase.com > seu projeto > Settings > API
#
# A chave "anon" é pública por natureza: ela vai para o navegador e quem
# protege os dados são as regras de acesso do banco (RLS), já definidas em
# supabase/esquema.sql. Nunca use aqui a chave "service_role".

VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-aqui"
