<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
      O TEMA DEPOIS DA ABERTURA.

      O fundo da janela é BRANCO de propósito. Era `@null`, e com o tema
      escuro do celular o intervalo entre a abertura e o primeiro desenho
      da página ficava PRETO — a "tela preta" do primeiro APK. Branco
      emenda com a tela de espera do index.html, que é branca.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/fundo_abertura</item>
    </style>

    <!--
      A ABERTURA.

      Do Android 12 em diante o sistema desenha a abertura sozinho: um
      ícone no centro sobre uma cor. Sem estas linhas ele escolhia a cor
      pelo tema do celular — preta no modo escuro — e o ícone do exemplo
      do Capacitor. Agora é o losango da Malachias sobre branco, igual à
      tela de espera que vem logo depois.

      Até o Android 11 vale o `android:background`: a imagem `splash`,
      gerada do mesmo losango.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/fundo_abertura</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/abertura_logo</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
