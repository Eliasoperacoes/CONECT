<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
          O TECLADO: adjustResize, dito com todas as letras.

          Sem dizer, o Android escolhe sozinho, e em muitos aparelhos
          escolhe DESLOCAR a janela para cima quando o teclado abre. O
          Capacitor já encolhe a página até a borda do teclado; os dois
          juntos empurravam a barra de mensagem duas vezes, e sobrava uma
          faixa vazia entre ela e o teclado — o "aspecto de bug" que o
          Elias relatou. Com adjustResize a janela fica parada e só o
          Capacitor ajusta.
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              OS ATALHOS DO ÍCONE abrem o aplicativo com conecta://abrir?atalho=...
              Quem lê o endereço é `ouvirEnderecosDoAplicativo` (aplicativo.ts).
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="conecta" android:host="abrir" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
          QUEM RECEBE O AVISO É O NOSSO SERVIÇO, e não o do plugin.

          O Android entrega a mensagem a um serviço só. O `ServicoDeAvisos`
          estende o do Capacitor (o token continua sendo guardado) e
          acrescenta o aviso com "Responder". O original sai daqui: com os
          dois declarados, o Android escolheria um, e não necessariamente
          o nosso.
        -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".ServicoDeAvisos"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- O "Responder" da notificação: só o próprio aplicativo o chama -->
        <receiver
            android:name=".RespostaRapida"
            android:exported="false" />

        <!--
          O AVISO NA BARRA DO ANDROID.

          Ícone: o Android pinta de branco tudo que não é transparente. O
          ícone do aplicativo (quadrado azul cheio) virava um quadrado
          branco; este é só o balão, em silhueta.

          Canal: "mensagens" com importância alta, que é o que faz o aviso
          descer por cima da tela. O canal padrão do Firebase só põe na
          barra, e a pessoa não vê. É criado em `ligarAvisoNativo`.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_conecta" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/cor_conecta" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="mensagens" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      O QUE O SISTEMA USA DO APARELHO.

      Sem estas linhas o WebView NEGA em silêncio: a câmera do ponto e do
      QR não abria, e o recado de voz não gravava — nem o pedido de
      permissão chegava a aparecer, porque o Android não pede o que o
      aplicativo não declarou.

      O pedido acontece na hora do uso (tocar em "Bater ponto", segurar o
      microfone), e não na abertura: pedir tudo de uma vez, antes de a
      pessoa saber para quê, é o jeito mais rápido de ouvir "não".
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A câmera é pedida, mas o aplicativo instala em aparelho sem ela -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
